{
    "port": 8000,
    "user_name": "example",
    "user_pass": "changeMeToaBetterPassord",
    "output_names": {
        "0": "Haustür",
        "1": "Garagentor",
        "7": "Gartenlicht"
    },
    "input_names": {
        "0": "Türöffner",
        "2": "Klingel",
        "3": "HA Event",
        "4": "API Trigger",
        "5": "Workflow",
        "6": "Katzenbild"
    },
    "input_actions": {
        "0": [
            {
                "type": "output",
                "target": 0,
                "mode": "impulse",
                "duration": 3.5
            },
            {
                "type": "webhook",
                "url": "https://log.system/door_opened"
            }
        ],
        "1": {
            "type": "output",
            "target": 7,
            "mode": "toggle"
        },
        "2": [
            {
                "type": "webhook",
                "url": "https://api.telegram.org/bot<DEIN_BOT_TOKEN>/sendMessage",
                "method": "POST",
                "payload": {
                    "chat_id": "<DEINE_CHAT_ID>",
                    "text": "🔔 Es hat an der Haustür geklingelt!"
                }
            },
            {
                "type": "delay",
                "duration": 5
            }
        ],
        "3": [
            {
                "type": "webhook",
                "url": "https://homeassistant.local:8123/api/webhook/some_hook_id",
                "method": "POST",
                "verify_ssl": false
            }
        ],
        "4": [
            {
                "type": "webhook",
                "url": "https://service.api.com/v1/trigger",
                "method": "POST",
                "headers": {
                    "X-API-KEY": "DEIN_GEHEIMER_API_SCHLUESSEL",
                    "Content-Type": "application/json"
                },
                "payload": { "event": "trigger_from_piface" }
            }
        ],
        "5": [
            {
                "type": "webhook",
                "url": "https://service.one/start",
                "sequence_tag": "workflow_A"
            },
            {
                "type": "delay",
                "duration": 5,
                "sequence_tag": "workflow_A"
            },
            {
                "type": "webhook",
                "url": "https://service.one/end",
                "sequence_tag": "workflow_A"
            },
            {
                "type": "output",
                "target": 1,
                "mode": "toggle"
            }
        ],
        "6": [
            {
                "type": "webhook",
                "url": "https://cataas.com/cat",
                "method": "GET",
                "sequence_tag": "cat_telegram_flow",
                "store_response_as": "cat_image_data"
            },
            {
                "type": "webhook",
                "url": "https://api.telegram.org/bot<DEIN_BOT_TOKEN>/sendPhoto",
                "method": "POST",
                "sequence_tag": "cat_telegram_flow",
                "payload": {
                    "chat_id": "<DEINE_CHAT_ID>",
                    "caption": "Hier ist ein zufälliges Katzenbild!"
                },
                "attach_from_context": {
                    "form_field_name": "photo",
                    "context_variable": "cat_image_data",
                    "filename": "cat.jpg"
                }
            }
        ]
    },
    "impulse_duration": 2.0,
    "update_interval": 0.5,
    "log_file": "piface.log",
    "log_history_size": 50,

    "log_filter_exclude": [
        "Heartbeat",
        "SSL-Verifizierung"
    ],
    "heartbeat_url": null,
    "heartbeat_interval": 60
}
